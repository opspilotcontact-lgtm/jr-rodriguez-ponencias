---
// AIDA · INTERÉS — La historia, condensada y honesta. Sin marketing.
const milestones = [
  { year: "2 años", label: "La separación", caption: "Mis padres se separaron. Crecí con mis abuelos." },
  { year: "Adolescencia", label: "El vacío", caption: "Sin herramientas para gestionar lo que sentía." },
  { year: "2014", label: "El fondo", caption: "Año y medio encamado. Intento de suicidio." },
  { year: "2016", label: "Proyecto Hombre", caption: "Comunidad terapéutica. Crecimiento personal." },
  { year: "2019", label: "El alta", caption: "Salgo. Vuelvo a trabajar. Empiezo de nuevo." },
  { year: "Hoy", label: "El propósito", caption: "Empresa propia. Ponencias. Acompañamiento." },
];
---

<section id="historia" class="relative bg-bone text-ink py-24 md:py-32 paper">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-3 reveal">
        <div class="flex items-center gap-3">
          <span class="block w-8 h-px bg-ink"></span>
          <span class="eyebrow">Mi historia</span>
        </div>
        <p class="mt-4 text-sm text-ink/60 max-w-[16rem]">
          Lo que cuento en las ponencias, en versión corta. La completa
          la abro en cada sala, ante quien quiera escucharla.
        </p>
      </div>

      <div class="lg:col-span-9">
        <h2 class="font-display text-[clamp(2.4rem,5.4vw,4.6rem)] leading-[0.96] tracking-[-0.03em] reveal">
          Vengo de una familia<br/>
          <span class="text-ink/40">desestructurada.</span><br/>
          <span class="relative inline-block">
            Y de un vacío
            <span class="absolute left-0 right-0 -bottom-1 h-[6px] bg-ember/80 -z-10" aria-hidden="true"></span>
          </span>
          que aprendí tarde a nombrar.
        </h2>

        <div class="mt-12 grid md:grid-cols-2 gap-8 md:gap-12 max-w-4xl">
          <div class="space-y-5 font-serif text-lg leading-relaxed text-ink/85 reveal">
            <p>
              Mis padres se separaron cuando yo tenía dos años. Crecí con mis abuelos.
              No sabía gestionar lo que sentía — había mucho vacío, muchas emociones,
              ningún manual.
            </p>
            <p>
              Lo intenté por el camino corto: amigos que no eran amigos, sustancias
              que prometían tapar el ruido. Lo probé casi todo. Y lo que parecía un
              alivio se convirtió en cárcel.
            </p>
          </div>
          <div class="space-y-5 font-serif text-lg leading-relaxed text-ink/85 reveal">
            <p>
              En 2014 toqué fondo. Año y medio encamado, mezclando consumo con medicación
              psiquiátrica. Llegué a un intento de suicidio. Eso fue el final de un capítulo
              y el principio, sin saberlo, de otro.
            </p>
            <p>
              En 2016 entré en Proyecto Hombre. Tres años de trabajo personal duro.
              En 2019 me dieron el alta. A los seis meses fundé mi empresa.
              Hoy estoy aquí — para ayudar a quien quiera escuchar.
            </p>
          </div>
        </div>

        <a href="#relato" class="mt-12 inline-flex items-center gap-2 text-sm font-semibold border-b-2 border-ink pb-1 hover:gap-3 hover:text-ember hover:border-ember transition-all reveal">
          Leer el relato completo en seis pasos
          <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Línea de tiempo simbólica -->
    <div class="mt-24 md:mt-28 reveal">
      <div class="flex items-end justify-between flex-wrap gap-4 mb-8">
        <h3 class="font-display text-2xl md:text-3xl tracking-tight">
          La línea de tiempo
        </h3>
        <p class="text-xs text-ink/50 uppercase tracking-[0.2em]">Sin maquillar · sin omitir</p>
      </div>

      <ol class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 border-t border-ink/15">
        {milestones.map((m, i) => (
          <li class={`group relative py-6 lg:py-8 px-3 lg:px-5 border-b border-ink/15 ${i < milestones.length - 1 ? "lg:border-r" : ""} ${i % 2 === 0 ? "border-r" : ""} ${(i + 1) % 3 === 0 ? "md:border-r-0 lg:border-r" : "md:border-r"}`}>
            <span class="absolute top-0 left-0 w-0 group-hover:w-full h-px bg-ember transition-all duration-700"></span>
            <p class="font-display text-xs tracking-[0.2em] text-ember">
              {m.year}
            </p>
            <p class="mt-3 font-display text-lg lg:text-xl leading-tight">
              {m.label}
            </p>
            <p class="mt-2 text-xs text-ink/60 leading-relaxed">
              {m.caption}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
