---
// AIDA · DESEO — Los 4 pilares de la vida estructurada. Lo que sostiene.
const pilares = [
  {
    n: "01",
    t: "Trabajo",
    sub: "Ocupación con sentido",
    body: "Una actividad estable, con propósito y horarios. No para llenar el día — para tener algo que sujete los pies en el suelo cuando todo lo demás tiembla.",
    warning: "Cuidado con caer en el otro extremo: trabajar, trabajar y trabajar también te revienta.",
  },
  {
    n: "02",
    t: "Tiempo libre y ocio",
    sub: "Lo que te alimenta",
    body: "Hobbies, descanso, actividades que te devuelven energía. La mente necesita sitios donde no haya que rendir. Si todo es deber, vuelven los pensamientos que llevan al consumo.",
    warning: null,
  },
  {
    n: "03",
    t: "Deporte",
    sub: "Cuerpo en movimiento",
    body: "Actividad física regular. No por estética — por química, por descarga, por dormir mejor, por no estar quieto frente a uno mismo todo el rato.",
    warning: null,
  },
  {
    n: "04",
    t: "Equilibrio social",
    sub: "Soledad y compañía, en su dosis",
    body: "Saber estar contigo sin huir, y saber estar con otros sin perderte. Tiempo de calidad con gente que suma, y tiempo solo que no sea aislamiento.",
    warning: null,
  },
];
---

<section id="pilares" class="bg-bone-warm text-ink py-24 md:py-32 paper relative overflow-hidden">
  <div class="mx-auto max-w-[1400px] px-6 md:px-10">
    <div class="grid lg:grid-cols-12 gap-10 mb-16 lg:mb-20">
      <div class="lg:col-span-7 reveal">
        <div class="flex items-center gap-3 mb-6">
          <span class="block w-8 h-px bg-ink"></span>
          <span class="eyebrow">Los pilares · prevención</span>
        </div>
        <h2 class="font-display text-[clamp(2.4rem,5.4vw,4.6rem)] leading-[0.96] tracking-[-0.03em]">
          Lo que sostiene<br/>
          <span class="text-ink/40">una vida</span> reconstruida.
        </h2>
      </div>
      <div class="lg:col-span-5 reveal flex items-end">
        <p class="font-serif text-lg leading-relaxed text-ink/80 max-w-md">
          Cuatro pilares que aplico cada día desde que salí. No son una receta —
          son lo que a mí me sostiene. Cuando uno de los cuatro se cae,
          los otros tres no aguantan.
        </p>
      </div>
    </div>

    <ol class="grid md:grid-cols-2 gap-6 lg:gap-8">
      {pilares.map((p) => (
        <li class="group relative reveal bg-bone border border-ink/10 hover:border-ink p-8 md:p-10 transition-colors duration-500">
          <div class="flex items-start justify-between gap-6">
            <div>
              <span class="font-display text-xs tracking-[0.22em] text-ember">{p.sub}</span>
              <h3 class="mt-2 font-display text-3xl md:text-4xl leading-tight tracking-[-0.025em]">
                {p.t}
              </h3>
            </div>
            <span class="font-display text-5xl md:text-6xl text-ink/10 leading-none tracking-[-0.04em] shrink-0">
              {p.n}
            </span>
          </div>

          <p class="mt-6 font-serif text-base md:text-lg leading-relaxed text-ink/80">
            {p.body}
          </p>

          {p.warning && (
            <div class="mt-6 pt-5 border-t border-ink/15 flex items-start gap-3">
              <svg class="w-4 h-4 mt-1 text-ember shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 1l7 12H1zM8 6v3M8 11v.5"/>
              </svg>
              <p class="text-sm text-ink/70 leading-relaxed">
                {p.warning}
              </p>
            </div>
          )}

          <span class="absolute bottom-0 left-0 w-0 group-hover:w-full h-[2px] bg-ember transition-all duration-700"></span>
        </li>
      ))}
    </ol>

    <!-- Frase de cierre -->
    <div class="mt-20 reveal max-w-3xl">
      <blockquote class="border-l-2 border-ember pl-6 font-serif italic text-xl md:text-2xl leading-snug text-ink/85">
        La estructura no es una jaula. Es lo que te permite vivir
        sin volver al sitio del que tanto costó salir.
      </blockquote>
    </div>
  </div>
</section>
