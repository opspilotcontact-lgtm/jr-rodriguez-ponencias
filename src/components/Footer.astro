---
const year = new Date().getFullYear();
const cols = [
  {
    title: "Navegación",
    items: [
      { l: "Mi historia", h: "#historia" },
      { l: "El relato", h: "#relato" },
      { l: "Ponencias", h: "#ponencias" },
      { l: "Acompañamiento", h: "#acompanamiento" },
      { l: "Pilares", h: "#pilares" },
      { l: "Contacto", h: "#contacto" },
    ],
  },
  {
    title: "Para qué público",
    items: [
      { l: "Empresas y equipos", h: "#ponencias" },
      { l: "Centros educativos y FP", h: "#ponencias" },
      { l: "Eventos del sector", h: "#ponencias" },
      { l: "Asociaciones y entidades", h: "#ponencias" },
      { l: "Acompañamiento individual", h: "#acompanamiento" },
    ],
  },
  {
    title: "Legal",
    items: [
      { l: "Aviso legal", h: "#legal" },
      { l: "Política de privacidad", h: "#privacidad" },
      { l: "Política de cookies", h: "#cookies" },
    ],
  },
];
---

<footer class="bg-deep text-bone relative overflow-hidden">
  <div class="h-px bg-ember/30"></div>

  <div class="mx-auto max-w-[1400px] px-6 md:px-10 py-16 md:py-20">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16">
      <div class="lg:col-span-5">
        <a href="#top" class="inline-flex items-center gap-3" aria-label="JR Rodríguez — Inicio">
          <span class="inline-flex w-11 h-11 items-center justify-center bg-bone text-ink font-display text-base rounded-sm">
            JR
          </span>
          <span class="font-display text-lg tracking-tight">JR Rodríguez</span>
        </a>

        <p class="mt-6 font-serif text-2xl leading-snug tracking-tight max-w-md">
          Hablar desde la verdad,<br/>
          ayudar desde la herida cerrada.
        </p>
        <p class="mt-3 text-bone/60 text-sm max-w-sm leading-relaxed">
          Ponencias y acompañamiento personal sobre adicción, depresión y reconstrucción.
          Desde Andalucía para toda España.
        </p>

        <div class="mt-8 flex items-center gap-3">
          <a href="#contacto" class="w-10 h-10 inline-flex items-center justify-center border border-bone/25 hover:bg-ember hover:text-bone hover:border-ember transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="4"/>
              <circle cx="12" cy="12" r="3.5"/>
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/>
            </svg>
          </a>
          <a href="#contacto" class="w-10 h-10 inline-flex items-center justify-center border border-bone/25 hover:bg-ember hover:text-bone hover:border-ember transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4 4h4v4H4zM4 10h4v10H4zM10 10h4v1.5c.7-1 2-1.7 3.5-1.7 3 0 4.5 2 4.5 5V20h-4v-4.5c0-1.5-.5-2.5-2-2.5s-2 1-2 2.5V20h-4z"/>
            </svg>
          </a>
          <a href="#contacto" class="w-10 h-10 inline-flex items-center justify-center border border-bone/25 hover:bg-ember hover:text-bone hover:border-ember transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22 8s-.2-1.4-.8-2c-.7-.8-1.5-.8-1.9-.9C16.5 5 12 5 12 5s-4.5 0-7.3.1c-.4.1-1.2.1-1.9.9C2.2 6.6 2 8 2 8s-.2 1.6-.2 3.3v1.5c0 1.6.2 3.3.2 3.3s.2 1.4.8 2c.7.8 1.7.8 2.1.9 1.5.1 6.6.2 6.6.2s4.5 0 7.3-.2c.4-.1 1.2-.1 1.9-.9.6-.6.8-2 .8-2s.2-1.6.2-3.3v-1.5c0-1.6-.2-3.3-.2-3.3zM10 14.5v-5l4.5 2.5z"/>
            </svg>
          </a>
        </div>
      </div>

      {cols.map((col) => (
        <div class="lg:col-span-2">
          <p class="eyebrow text-bone/55 mb-5">{col.title}</p>
          <ul class="space-y-3">
            {col.items.map((item) => (
              <li>
                <a href={item.h} class="text-sm text-bone/85 hover:text-ember transition-colors">
                  {item.l}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="lg:col-span-3">
        <p class="eyebrow text-bone/55 mb-5">Avisos por email</p>
        <p class="text-sm text-bone/75 leading-relaxed mb-4">
          Te aviso cuando publique nuevos artículos o cuando agende fechas para ponencias abiertas. Sin spam.
        </p>
        <form class="flex border border-bone/25 focus-within:border-ember transition-colors" onsubmit="event.preventDefault(); window.location.href='#contacto';">
          <input
            type="email"
            placeholder="tu@email.com"
            aria-label="Email para avisos"
            class="flex-1 bg-transparent px-3 py-2.5 text-sm text-bone placeholder:text-bone/40 outline-none"
          />
          <button type="submit" class="px-4 bg-ember text-bone font-semibold text-sm hover:brightness-95 transition" aria-label="Suscribir">
            →
          </button>
        </form>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-bone/15 flex flex-wrap items-center justify-between gap-4 text-xs text-bone/55">
      <p>© {year} JR Rodríguez · Todos los derechos reservados.</p>
      <p>Desde Andalucía, para quien necesite escuchar.</p>
    </div>
  </div>
</footer>
