---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Relato from "../components/Relato.astro";
import Talks from "../components/Talks.astro";
import Acompanamiento from "../components/Acompanamiento.astro";
import Pilares from "../components/Pilares.astro";
import Testimonials from "../components/Testimonials.astro";
import BlogTeaser from "../components/BlogTeaser.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="JR Rodríguez — Ponencias sobre adicción, depresión y reconstrucción personal"
  description="No vengo a contaros cómo caí. Vengo a contaros cómo volví a levantarme. Testimonio real para empresas, centros formativos y eventos. Ponencias y acompañamiento personal desde la experiencia."
>
  <Nav />
  <main id="contenido">
    <Hero />
    <About />
    <Relato />
    <Talks />
    <Acompanamiento />
    <Pilares />
    <Testimonials />
    <BlogTeaser />
    <Contact />
  </main>
  <Footer />
</Layout>
